# ---------------------------------------------------------------------------
# Environment variables required by the backend.
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# MongoDB Atlas connection string (see https://cloud.mongodb.com).
# Do NOT commit the real value.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/<database>?appName=<app>

# Port the Express server listens on.
PORT=5000

# JWT signing secret. Use a long random string (>= 32 characters).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_random_48_byte_hex_string

# "development" or "production". In production, auth cookies are marked Secure.
NODE_ENV=development

# Mailtrap token and verified sender domain (see https://mailtrap.io).
SENDING_ONBOARDING_API_TOKEN=your_mailtrap_api_token
EMAIL_DOMAIN=hello@example.com

# Base URL of the frontend, used to build password-reset links.
CLIENT_URL=http://localhost:5173
