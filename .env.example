# ---------------------------------------------------------------------------
# Environment variables required by the backend.
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# MongoDB Atlas connection string (see https://cloud.mongodb.com).
# Do NOT commit the real value.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/<database>?appName=<app>

# Port the Express server listens on.
PORT=5000

# JWT signing secret. Use a long random string (>= 32 characters); the
# application rejects the placeholder below.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_random_48_byte_hex_string

# "development" or "production". In production, auth cookies are marked Secure.
NODE_ENV=development

# Mailtrap SMTP settings (find the host and credentials in your Mailtrap inbox).
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_smtp_username
SMTP_PASS=your_mailtrap_smtp_password
SMTP_SECURE=false
# Sender email address verified or accepted by Mailtrap.
EMAIL_DOMAIN=hello@example.com

# Exact frontend origin allowed by CORS and used to build password-reset links.
# Keep the production frontend and API on the same site because auth cookies
# use SameSite=Strict (for example, app.example.com and api.example.com).
CLIENT_URL=http://localhost:5173
